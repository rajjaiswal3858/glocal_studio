{
  "name": "glocal-studio",
  "version": "1.0.0",
  "description": "Glocal Studio",
  "main": "index.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:server": "nodemon --watch build --exec \"node --env-file-if-exists=.env build/public/server.js\"",
    "dev:build-server": "webpack --config webpack.server.js --watch",
    "dev:build-client": "webpack --config webpack.client.js --watch",
    "build": "npm-run-all --parallel build:*",
    "build:server": "cross-env NODE_ENV=production webpack --config webpack.server.js --mode=production",
    "build:client": "cross-env NODE_ENV=production webpack --config webpack.client.js --mode=production",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env build/public/server.js",
    "lint": "eslint ./src --ext .js,.jsx,.ts,.tsx"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.0",
    "@getbrevo/brevo": "^2.2.0",
    "@loadable/component": "^5.16.7",
    "@loadable/server": "^5.16.7",
    "@marsidev/react-turnstile": "^1.1.0",
    "@mui/material": "^6.4.7",
    "@use-gesture/react": "^10.3.1",
    "body-parser": "^2.2.0",
    "classnames": "^2.5.1",
    "express": "^4.18.2",
    "framer-motion": "^12.6.2",
    "fslightbox-react": "^2.0.0",
    "gsap": "^3.12.7",
    "hamburger-react": "^2.5.2",
    "lenis": "^1.3.3",
    "lottie-react": "^2.4.1",
    "query-string": "^9.2.1",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.56.1",
    "react-router-dom": "^6.21.1",
    "react-use-measure": "^2.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@loadable/babel-plugin": "^5.16.1",
    "@loadable/webpack-plugin": "^5.15.2",
    "babel-loader": "^10.0.0",
    "babel-plugin-import": "^1.13.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-manifest-plugin": "^5.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
